rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owner(uid) {
      return verified() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId} {
      allow read, create, update, delete: if owner(userId);

      match /addresses/{addressId} {
        allow read, create, update, delete: if owner(userId);
      }

      match /wishlist/{itemId} {
        allow read, create, update, delete: if owner(userId);
      }
    }

    // Public catalog reads. Only active admins can edit catalog records.
    // Customer checkout uses the Cloud Function, which runs with trusted server privileges.
    match /products/{productId} {
      allow read: if true;
      allow write: if admin();
    }

    // Single source of truth for orders.
    // Customers can read only their own orders.
    // Active admins can read/update/delete orders.
    // Direct customer/browser order creation is blocked; createOrder Cloud Function creates orders.
    match /orders/{orderId} {
      allow read: if admin() ||
        (verified() &&
          (
            resource.data.customer.uid == request.auth.uid ||
            resource.data.customerUid == request.auth.uid
          ));

      allow create: if false;
      allow update, delete: if admin();
    }

    match /promos/{promoId} {
      allow read: if true;
      allow write: if admin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if admin();
    }

    match /content/{contentId} {
      allow read: if true;
      allow write: if admin();
    }

    match /admins/{adminId} {
      allow read: if (signedIn() && request.auth.uid == adminId) || admin();
      allow create: if signedIn() &&
        request.auth.uid == adminId &&
        request.auth.token.email == "vracelle2@gmail.com" &&
        request.resource.data.active == true &&
        request.resource.data.role == "admin" &&
        request.resource.data.email == "vracelle2@gmail.com";
      allow update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
